{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/config", "destination": "/api/config.js" },
    { "source": "/", "destination": "/home.html" },
    { "source": "/home", "destination": "/home.html" },
    { "source": "/index.html", "destination": "/home.html" },
    { "source": "/feed", "destination": "/screens/light/feed.html" },
    { "source": "/login", "destination": "/screens/light/login.html" },
    { "source": "/faculty", "destination": "/screens/light/faculty.html" },
    { "source": "/profile", "destination": "/screens/light/profile.html" },
    { "source": "/study", "destination": "/screens/light/study.html" },
    { "source": "/clubs", "destination": "/screens/light/clubs.html" },
    { "source": "/dark/feed", "destination": "/screens/dark/feed.html" },
    { "source": "/dark/login", "destination": "/screens/dark/login.html" },
    { "source": "/dark/faculty", "destination": "/screens/dark/faculty.html" },
    { "source": "/dark/profile", "destination": "/screens/dark/profile.html" },
    { "source": "/dark/study", "destination": "/screens/dark/study.html" },
    { "source": "/dark/clubs", "destination": "/screens/dark/clubs.html" }
  ]
}
